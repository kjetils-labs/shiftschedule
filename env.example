COMPOSE_PROJECT_NAME=shiftschedule
POSTGRES_DB=shiftschedule
POSTGRES_USER=user
POSTGRES_PASSWORD=Password123
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_ENABLE_TLS=false
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=Password123
API_HOST=127.0.0.1
API_PORT=8080
TIMEZONE=Europe/Oslo

# dev: trust the X-Dev-User header, falling back to DEV_USER_EMAIL.
# oidc: verify ID tokens (Authorization: Bearer) against Dex. 
AUTH_MODE=dev
DEV_USER_EMAIL=ola@example.com
OIDC_ISSUER_URL=http://127.0.0.1:5556/dex
OIDC_CLIENT_ID=shiftschedule-web

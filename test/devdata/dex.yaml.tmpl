# GENERATED by `task dex:config` from internal/devdata. Do not edit by hand: change the people there and regenerate.
#
# Dex for local development only. Every user has the password "password".
#
# Static passwords cannot carry a "groups" claim, so logging in through this config never changes team membership: the
# memberships come from the dev generator. Real connectors (LDAP, GitHub, ...) send groups and the backend syncs them on login.
issuer: http://127.0.0.1:5556/dex

storage:
  type: memory

web:
  http: 0.0.0.0:5556

oauth2:
  skipApprovalScreen: true

enablePasswordDB: true

staticClients:
  # Public client for the Angular app (authorization code + PKCE, no secret).
  - id: shiftschedule-web
    name: Shift schedule
    public: true
    redirectURIs:
      - http://localhost:4200/
      - http://localhost:4200/auth/callback

staticPasswords:
{{- range .Users}}
  - email: {{.Email}}
    username: {{.Username}}
    userID: {{.UserID}}
    hash: "{{.Hash}}"
{{- end}}
